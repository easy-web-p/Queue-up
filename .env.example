# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Optional Payment Gateway (Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Pickup PIN signing key (REQUIRED in production — the server refuses to start without it)
HMAC_SECRET=""

# Development only: accept x-mock-* identity headers instead of a Firebase ID token.
# Ignored whenever NODE_ENV=production.
ALLOW_MOCK_AUTH="false"

# Canteen-local time zone used for every 15-minute pickup slot boundary.
QUEUEUP_TIMEZONE="Asia/Bangkok"

# Firebase Admin credentials. Required in production unless the platform
# provides Application Default Credentials (e.g. Cloud Run).
GOOGLE_APPLICATION_CREDENTIALS=""

# Set to "true" to enforce the Content Security Policy instead of report-only.
# The E2E suite runs with it enforced, so this is safe to enable.
CSP_ENFORCE="false"

# Comma-separated origins allowed to call the API cross-origin.
# Empty means same-origin only in production, any origin in development.
ALLOWED_ORIGINS=""

# Comma-separated platform administrator emails. Mirrors the break-glass clause
# in firestore.rules so the API and the rules agree on who may approve a school
# or issue custom claims.
SUPER_ADMIN_EMAILS="hi00000087@gmail.com"

# AI Layer 2 (scope-bound tool calling). Optional: without a key the assistant
# runs Layer 1 only and unrecognised questions escalate to the store.
GEMINI_MODEL="gemini-2.5-flash"
AI_LAYER2_TIMEOUT_MS="8000"

# --- Serverless / Vercel deployment ---
# Firebase Admin service account as raw JSON or base64. Serverless platforms
# have no writable path for a key file, so this replaces
# GOOGLE_APPLICATION_CREDENTIALS there. The server refuses to start without one.
FIREBASE_SERVICE_ACCOUNT=""

# Shared secret for scheduled job endpoints under /api/cron/*.
# Vercel Cron sends it as: Authorization: Bearer $CRON_SECRET
CRON_SECRET=""
