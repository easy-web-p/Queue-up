# QUEUEUP FIREBASE ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to '.env' and fill in your actual Firebase Project credentials

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
# The origin that serves /__/auth/handler for Google sign-in.
#
# Leave this UNSET unless you have a reason not to. Unset, the app uses
# <project>.firebaseapp.com, which Firebase both serves and pre-registers with
# Google — sign-in works with nothing else configured.
#
# Setting it to your own domain takes THREE steps, and doing only this one makes
# Google refuse every sign-in with "Error 400: redirect_uri_mismatch" before any
# app code runs:
#   1. proxy /__/auth/* to <project>.firebaseapp.com (see vercel.json)
#   2. add https://<your-domain>/__/auth/handler in Google Cloud Console →
#      Credentials → OAuth 2.0 Client IDs → Authorised redirect URIs
#   3. set VITE_FIREBASE_AUTH_HANDLER_REGISTERED=true below
# Step 2 is the one no code can check from the browser, so step 3 is how you tell
# the app it is done. Without it a custom value here is ignored (and the reason is
# logged to the console) rather than breaking sign-in for everyone.
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_AUTH_HANDLER_REGISTERED=false
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id_here

# ---------------------------------------------------------------------------
# SERVER-SIDE SECRETS — DO NOT ADD THESE HERE AS VITE_* VARIABLES
# ---------------------------------------------------------------------------
# Vite inlines every VITE_* variable into the client bundle, so anything secret
# placed there ships to every visitor's browser. Set these as Cloud Functions
# secrets instead:
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set OPN_SECRET_KEY
#
# Optional non-secret function config (functions/.env):
#   OPENAI_MODEL=gpt-3.5-turbo
