rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Custom claims are read with .get(key, default): a plain
    // request.auth.token.<missing> raises an evaluation error, and an error in
    // one arm of an `||` chain aborts the whole rule, so a later legitimate arm
    // (isSchoolAdmin, for instance) would never be reached.
    function claimRole() {
      return request.auth.token.get('role', '');
    }

    function claimAdminFlag() {
      return request.auth.token.get('admin', false) == true;
    }

    function isAdmin() {
      return isAuthenticated() && (
        claimRole() == 'admin' ||
        claimRole() == 'super_admin' ||
        claimAdminFlag()
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        // Primary: Custom Claims issued by Backend
        claimRole() == 'super_admin' ||
        claimAdminFlag() ||
        // Temporary Break-Glass Recovery Access (Must be verified email)
        (request.auth.token.get('email', '') == 'hi00000087@gmail.com' &&
         request.auth.token.get('email_verified', false) == true)
      );
    }

    function isSchoolAdmin(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (claimRole() == 'admin' && request.auth.token.get('schoolId', '') == schoolId)
      );
    }

    // A caller who operates a given store: platform admin, an account pinned to
    // that store by custom claims, or the store's registered owner.
    function isStoreOperator(storeId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.get('storeId', '') == storeId ||
        get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid
      );
    }

    // Strict immutability check for institutional roster identity
    function isMemberIdentityUnchanged() {
      return request.resource.data.schoolId == resource.data.schoolId &&
             request.resource.data.role == resource.data.role &&
             request.resource.data.email == resource.data.email &&
             request.resource.data.identifier == resource.data.identifier &&
             request.resource.data.fullName == resource.data.fullName;
    }

    // 1. Private User Profile: Only accessible by account owner and Admin
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      // User Order Summary Stats: Read by owner, written only by Server Transaction
      match /stats/{statDoc} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Server authoritative only
      }
    }

    // 2. Public User Profile: Read-only for public, write locked to Server API
    match /public_profiles/{userId} {
      allow read: if true;
      allow write: if false; // Role and memberSince must be synced through Server API only
    }

    // 3. Stores Collection
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSuperAdmin() || isAdmin();
      allow update: if isSuperAdmin() || (
        isAuthenticated() && 
        resource.data.ownerId == request.auth.uid &&
        // Immutable schoolId: Merchant cannot change their store's schoolId!
        (!('schoolId' in request.resource.data) || request.resource.data.schoolId == resource.data.schoolId)
      );
      allow delete: if isSuperAdmin();

      // Store staff and members
      match /members/{memberId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == memberId || 
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );
        allow write: if isSuperAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid);
      }

      // Store daily statistics
      match /daily_stats/{date} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid || 
          isAdmin()
        );
        allow write: if false;
      }
    }

    // 4. Menu Items: Top-level collection for cross-store query
    match /menu_items/{menuItemId} {
      allow read: if true;
      // A merchant may only touch menu items belonging to a store they operate.
      allow create: if isStoreOperator(request.resource.data.storeId);
      allow update: if isStoreOperator(resource.data.storeId) &&
                       request.resource.data.storeId == resource.data.storeId;
      allow delete: if isStoreOperator(resource.data.storeId);
    }

    // 5. Orders: Server authoritative (Command Model via Express API)
    match /orders/{orderId} {
      // Readable by customer who placed it, store merchant, super admin, or school admin of that school
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isStoreOperator(resource.data.storeId) ||
        isSuperAdmin() ||
        isSchoolAdmin(resource.data.schoolId)
      );
      // Direct client writing is FORBIDDEN. All orders must go through /api/orders
      allow write: if false;

      // Order Audit Events Subcollection
      match /events/{eventId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid ||
          isStoreOperator(get(/databases/$(database)/documents/orders/$(orderId)).data.storeId) ||
          isAdmin()
        );
        allow write: if false;
      }
    }

    // 6. Chats and Messages
    match /chats/{chatId} {
      // A thread is visible to its participants and to operators of ITS store.
      // A blanket "any merchant" clause here would expose every customer
      // conversation in every canteen to every registered merchant.
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds ||
        isStoreOperator(resource.data.storeId) ||
        isSuperAdmin()
      );
      // Create: user must be in the participantIds array and match customerId
      allow create: if isAuthenticated() && (
        (request.auth.uid in request.resource.data.participantIds &&
         request.resource.data.customerId == request.auth.uid) ||
        isStoreOperator(request.resource.data.storeId) ||
        isSuperAdmin()
      );
      // Update: MUST be an existing participant or the store's operator, and
      // participantIds, storeId, customerId can never be modified.
      allow update: if isAuthenticated() &&
        request.resource.data.participantIds == resource.data.participantIds &&
        request.resource.data.storeId == resource.data.storeId &&
        request.resource.data.customerId == resource.data.customerId &&
        (
          request.auth.uid in resource.data.participantIds ||
          isStoreOperator(resource.data.storeId) ||
          isSuperAdmin()
        );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds ||
          isStoreOperator(get(/databases/$(database)/documents/chats/$(chatId)).data.storeId) ||
          isSuperAdmin()
        );
        // Message creation: MUST be an authentic participant of the chat room
        // senderRole restricted to customer/merchant only (ai_assistant/system can ONLY be written by Admin SDK)
        // Message size bounded to 2000 chars to prevent DoS/overflow
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          request.resource.data.senderRole in ['customer', 'merchant'] &&
          request.resource.data.message.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // 7. Canteens
    match /canteens/{canteenId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. School Applications: Public submission, Super Admin management ONLY
    match /school_applications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // 9. Schools: Public read of registered schools, Super Admin write ONLY
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 10. School Members: Institutional Authorized Roster with Field-Level Immutability
    match /school_members/{memberId} {
      // The roster holds fullName, email and student identifiers. Exposing it to
      // every signed-in account would let any user enumerate a whole institution.
      // A member may read their own record (by uid or by verified email, so an
      // unclaimed record can still be found during claiming); admins read all.
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isSchoolAdmin(resource.data.schoolId) ||
        resource.data.claimedByUid == request.auth.uid ||
        (request.auth.token.get('email_verified', false) == true &&
         resource.data.email == request.auth.token.get('email', ''))
      );
      allow create: if isSuperAdmin() || isSchoolAdmin(request.resource.data.schoolId);
      allow update: if isSuperAdmin() || 
        // Case 1: School Admin update (Restricted to non-security fields; CANNOT alter role, schoolId, email, identifier, or claiming state)
        (
          isSchoolAdmin(resource.data.schoolId) &&
          isMemberIdentityUnchanged() &&
          request.resource.data.claimedByUid == resource.data.claimedByUid &&
          request.resource.data.isRegistered == resource.data.isRegistered
        ) ||
        // Case 2: Self-Claim by verified user (Only claiming previously unclaimed roster record)
        (
          isAuthenticated() &&
          request.auth.token.get('email_verified', false) == true &&
          resource.data.email == request.auth.token.get('email', '') &&
          resource.data.status == 'active' &&
          isMemberIdentityUnchanged() &&
          (resource.data.claimedByUid == null || resource.data.claimedByUid == request.auth.uid) &&
          request.resource.data.claimedByUid == request.auth.uid &&
          request.resource.data.isRegistered == true
        );
      allow delete: if isSuperAdmin() || isSchoolAdmin(resource.data.schoolId);
    }

    // 11. User Devices (FCM Push Tokens)
    match /user_devices/{deviceId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 12. Notifications (Central Notification Inbox)
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
      allow create, delete: if false; // Server authoritative via Firebase Admin SDK only
      allow update: if isAuthenticated() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    // 13. Catch-all: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
