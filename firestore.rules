rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 🔐 HELPER FUNCTIONS FOR RBAC & AUTHORIZATION
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Claims are read with get(key, default): a token without the claim simply reads
    // as the default. Addressing them directly (request.auth.token.admin) raises
    // "Property admin is undefined" for every user who is not an admin — which is
    // most of them. The result happened to stay correct because an error inside an
    // || is tolerated, but that is a property of the evaluator, not of these rules.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        (request.auth.token.get('email', '') in ['58140@lomsak.ac.th', 'hi00000087@gmail.com', 'easy.web.p@gmail.com'])
      );
    }

    function isStaffSupervisor() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.get('role', '') == 'staff_supervisor' ||
        request.auth.token.get('staffSupervisor', false) == true
      );
    }

    function isStoreOwner(storeId) {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/shops/$(storeId)) && 
         get(/databases/$(database)/documents/shops/$(storeId)).data.ownerUid == request.auth.uid)
      );
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidNumber(val) {
      return val is int || val is float;
    }

    // 🔒 Coupled Order State Machine Validation (Ensures status and queueStatus advance in synchronized pairs)
    function isValidOrderStateTransition(oldStatus, oldQueue, newStatus, newQueue) {
      return (oldStatus == newStatus && oldQueue == newQueue) ||
             (oldStatus == 'PENDING' && oldQueue == 'waiting' && newStatus == 'CONFIRMED' && newQueue == 'waiting') ||
             (oldStatus == 'CONFIRMED' && oldQueue == 'waiting' && newStatus == 'PREPARING' && newQueue == 'cooking') ||
             (oldStatus == 'PREPARING' && oldQueue == 'cooking' && newStatus == 'READY' && newQueue == 'ready') ||
             (oldStatus == 'READY' && oldQueue == 'ready' && newStatus == 'COMPLETED' && newQueue == 'completed') ||
             ((oldStatus == 'PENDING' || oldStatus == 'CONFIRMED') && newStatus == 'CANCELLED' && newQueue == 'cancelled');
    }

    // ==========================================
    // 1. FOOD CATEGORIES (Store Isolated or Admin Default)
    // ==========================================
    match /food_categories/{catId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (request.resource.data.storeId != null && isStoreOwner(request.resource.data.storeId))
      ) && isValidString(request.resource.data.name, 1, 100);
      
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (
          resource.data.storeId != null && 
          isStoreOwner(resource.data.storeId) &&
          request.resource.data.storeId == resource.data.storeId &&
          isValidString(request.resource.data.name, 1, 100)
        )
      );
      
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.storeId != null && isStoreOwner(resource.data.storeId))
      );
    }

    // ==========================================
    // 2. PRODUCTS / MENU (Store Isolation Enforced)
    // ==========================================
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (request.resource.data.storeId != null && isStoreOwner(request.resource.data.storeId))
      ) && isValidString(request.resource.data.name, 1, 250) && 
        isValidNumber(request.resource.data.price) && request.resource.data.price > 0 &&
        (!('priceSatang' in request.resource.data) || (isValidNumber(request.resource.data.priceSatang) && request.resource.data.priceSatang > 0)) &&
        (!('stock' in request.resource.data) || (isValidNumber(request.resource.data.stock) && request.resource.data.stock >= 0)) &&
        // Declared allergens drive a safety check, so the shape is enforced here
        // rather than left for the reader to cope with.
        (!('allergens' in request.resource.data) || (request.resource.data.allergens is list && request.resource.data.allergens.size() <= 20));
      
      // 🔒 Lock storeId: Store Owner cannot reassign products to other stores, and price must be positive
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (
          resource.data.storeId != null && 
          isStoreOwner(resource.data.storeId) &&
          request.resource.data.storeId == resource.data.storeId &&
          (!('price' in request.resource.data) || (isValidNumber(request.resource.data.price) && request.resource.data.price > 0)) &&
          (!('priceSatang' in request.resource.data) || (isValidNumber(request.resource.data.priceSatang) && request.resource.data.priceSatang > 0)) &&
          (!('stock' in request.resource.data) || (isValidNumber(request.resource.data.stock) && request.resource.data.stock >= 0)) &&
          (!('allergens' in request.resource.data) || (request.resource.data.allergens is list && request.resource.data.allergens.size() <= 20))
        )
      );
      
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.storeId != null && isStoreOwner(resource.data.storeId))
      );
    }

    // ==========================================
    // 2.1 MODIFIER GROUPS (Store Isolated Options Engine)
    // ==========================================
    match /modifier_groups/{modifierGroupId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (request.resource.data.storeId != null && isStoreOwner(request.resource.data.storeId))
      ) && isValidString(request.resource.data.name, 1, 100);
      
      // 🔒 Lock storeId: Store Owner cannot reassign modifier groups across stores
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (
          resource.data.storeId != null && 
          isStoreOwner(resource.data.storeId) &&
          request.resource.data.storeId == resource.data.storeId &&
          isValidString(request.resource.data.name, 1, 100)
        )
      );
      
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.storeId != null && isStoreOwner(resource.data.storeId))
      );
    }

    // ==========================================
    // 3. SHOPS (Public Read, Owner / Admin Write)
    // ==========================================
    match /shops/{shopId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);
      
      // 🔒 Lock Admin Fields & ownerUid: Store Owner cannot change status, rating, reviewsCount, or transfer ownerUid
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isStoreOwner(shopId) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) &&
          (!('rating' in request.resource.data) || request.resource.data.rating == resource.data.rating) &&
          (!('reviewsCount' in request.resource.data) || request.resource.data.reviewsCount == resource.data.reviewsCount) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'location', 'hours', 'isOpen', 'contactPhone', 'logoUrl', 'bannerUrl',
            'operatingHours', 'operationalOverride', 'capacityConfig', 'slotCapacity', 'maxOrdersPerSlot', 'pickupSlots', 'updatedAt',
            'teamMembers', 'costRatioPercent'
          ])
        )
      );
      allow delete: if isAdmin();

      // Subcollection for store-isolated orders (Canonical orders live in root /orders; direct subcollection writes are blocked)
      match /orders/{orderId} {
        allow read: if isAuthenticated() && (isStoreOwner(shopId) || isAdmin() || resource.data.userId == request.auth.uid);
        allow write: if false; // Universal Server-Authoritative Backend Order Creation Only
      }

      // Subcollection for shop staff management
      match /staff/{staffUid} {
        allow read: if isAuthenticated() && (isStoreOwner(shopId) || request.auth.uid == staffUid || isAdmin());
        allow write: if isStoreOwner(shopId) || isAdmin();
      }

      // Subcollection for student vendor team allocations
      match /team/{docId} {
        allow read, write: if isStoreOwner(shopId) || isAdmin();
      }
    }

    // ==========================================
    // 3.1 STORE CAPACITY SLOTS (Backend Managed Only)
    // ==========================================
    match /store_slots/{slotId} {
      allow read: if true;
      allow write: if false; // 🔒 Universal Backend-Only: Slot booking and capacity mutations MUST be atomic via Cloud Functions
    }

    // ==========================================
    // 4. USERS COLLECTION (Ownership & Admin Protected)
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // On creation, normal users can only initialize profile data with non-privileged roles and safe keys
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (
          isOwner(userId) &&
          (!('roles' in request.resource.data) || request.resource.data.roles == ['customer'] || request.resource.data.roles == ['user']) &&
          // 🔒 `role` and `admin` are read by getEffectiveRoles() in the client. Left
          // unguarded, a user could self-assign role:'admin' / admin:true on their very
          // first profile write and unlock every admin & staff screen in the UI.
          (!('role' in request.resource.data) || request.resource.data.role == 'customer' || request.resource.data.role == 'user') &&
          (!('admin' in request.resource.data) || request.resource.data.admin == false) &&
          (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false) &&
          (!('isMerchantVerified' in request.resource.data) || request.resource.data.isMerchantVerified == false) &&
          (!('isMerchantRegistered' in request.resource.data) || request.resource.data.isMerchantRegistered == false) &&
          (!('activeRole' in request.resource.data) || request.resource.data.activeRole == 'customer' || request.resource.data.activeRole == 'user') &&
          (!('storeId' in request.resource.data))
        )
      );

      // 🔒 Lock Privilege Elevation: Users can only edit safe profile keys; email and roles are Admin/Backend only
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          // lastLoginAt is written by the sign-in path on every return visit. It is
          // a timestamp about the user's own session, carries no privilege, and
          // leaving it out meant every returning Google user's profile write was
          // refused — they were shown "Missing or insufficient permissions" for
          // simply logging in again.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'displayName', 'fullName', 'lastName', 'gender', 'birthDate', 'phone', 'school', 'photo', 'photoURL', 'avatar', 'accountId', 'updatedAt', 'lastLoginAt', 'pdpaAcceptedAt'
          ])
        )
      );

      allow delete: if isAdmin(); // Audit Trail protection

      // User Favorites Subcollection
      match /favorites/{favoriteId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }

    // ==========================================
    // 5. MERCHANT PROFILES & FINANCIALS
    // ==========================================
    match /merchantProfiles/{merchantId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);
      // 🔒 Lock ownerUid: Store Owner cannot transfer merchant profile ownership without Admin
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isStoreOwner(merchantId) &&
          request.resource.data.ownerUid == resource.data.ownerUid
        )
      );
      allow delete: if isAdmin();

      // Private Financial & PromptPay Config Subcollection
      match /private/finance {
        allow read, write: if isStoreOwner(merchantId);
      }

      // Staff Management Subcollection
      match /staff/{staffUid} {
        allow read: if isAuthenticated() && (isStoreOwner(merchantId) || request.auth.uid == staffUid);
        allow write: if isStoreOwner(merchantId) && (request.resource == null || request.resource.data.staffUid == staffUid);
      }
    }

    // ==========================================
    // 6. ORDERS (Canonical Order Storage & True State Machine Guard)
    // ==========================================
    match /orders/{orderId} {
      // Customer sees own orders, Merchant sees own store orders, Admin sees all.
      // Staff supervisors see all orders so the campus-wide queue monitor can run its
      // aggregate query: a Firestore query is rejected unless the rules authorize it
      // for every document it could return, so a monitor spanning all stalls cannot
      // work off the per-owner clauses above. Read-only — the state machine below
      // still restricts status changes to the owning store and admins, so staff can
      // observe congestion without acting on another stall's orders.
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isStaffSupervisor() ||
        resource.data.userId == request.auth.uid ||
        (resource.data.storeId != null && isStoreOwner(resource.data.storeId))
      );

      // 🔒 Universal Server-Authoritative Order Creation:
      // ALL Orders (PromptPay, Cash, Canteen Counter) MUST be created authoritatively by Cloud Functions.
      // Direct client-side creation is blocked completely (Admin SDK on Cloud Functions bypasses rules).
      allow create: if false;

      // 🔒 Restricted Update Keys & Synchronized State Transitions:
      // Operational KDS status updates are restricted to Store Owner & Admin, and MUST strictly follow synchronized state transitions.
      // Direct client mutation of paymentStatus / totalAmount is blocked for all client users (Admin must use Backend Cloud Functions).
      allow update: if isAuthenticated() && (
        (
          (isAdmin() || (resource.data.storeId != null && isStoreOwner(resource.data.storeId))) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['queueStatus', 'status', 'estimatedReadyTime', 'merchantNote', 'adminNote', 'updatedAt']) &&
          isValidOrderStateTransition(
            resource.data.status,
            resource.data.queueStatus,
            ('status' in request.resource.data ? request.resource.data.status : resource.data.status),
            ('queueStatus' in request.resource.data ? request.resource.data.queueStatus : resource.data.queueStatus)
          )
        ) ||
        (
          // 🔒 Customer can only cancel prior to kitchen preparation (PENDING/CONFIRMED & waiting)
          resource.data.userId == request.auth.uid &&
          (resource.data.status == 'PENDING' || resource.data.status == 'CONFIRMED') &&
          (resource.data.queueStatus == 'waiting' || !('queueStatus' in resource.data)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelReason', 'status', 'queueStatus', 'updatedAt']) &&
          request.resource.data.status == 'CANCELLED' &&
          (!('queueStatus' in request.resource.data) || request.resource.data.queueStatus == 'cancelled')
        )
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // 7. SECURITY & AUDIT LOGS (Backend-Only Immutable Audit Trail)
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // 🔒 Universal Backend-Only: Client cannot create, mutate or delete audit logs directly
    }

    // ==========================================
    // 8. SYSTEM EVALUATIONS / SURVEYS (One per User Anti-Spam)
    // ==========================================
    match /systemEvaluations/{evalId} {
      // 📖 Public read: the wall exists so the project's supervisor and reviewers
      // can see the scores without holding an account. Evaluators are told on the
      // form that their name and comment are shown publicly.
      allow read: if true;

      // ✍️ Backend-only write. The form takes no sign-in, so a collection open to
      // it would be open to everyone; submitSystemEvaluation validates the shape,
      // bounds every field and rate limits the caller.
      //
      // The previous rule required a uid-keyed document with a single `rating`
      // field, while the client wrote five scores under a timestamp id — so every
      // submission was rejected, the rejection was swallowed into localStorage, and
      // the page still said thank you. The shape now lives in one tested place
      // (functions/systemEvaluation.js) rather than in two that disagreed.
      allow write: if false;
    }

    match /evaluation_rate_limits/{callerKey} {
      // 🔒 The only bound on an unauthenticated endpoint.
      allow read, write: if false;
    }

    // ==========================================
    // 9. COUPONS & PROMOTIONS (Admin Write, Authenticated Read)
    // ==========================================
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // 10. IDEMPOTENCY KEYS (Internal & Owner Read)
    // ==========================================
    match /idempotency_keys/{keyId} {
      allow read: if isAuthenticated() && (keyId.matches('^' + request.auth.uid + '_.*') || isAdmin());
      allow write: if false; // Only manageable by Cloud Functions / Admin SDK
    }

    // ==========================================
    // 11. WEBHOOK EVENTS (Internal Backend Only)
    // ==========================================
    match /webhook_events/{eventId} {
      allow read, write: if false; // 🔒 Universal Backend-Only: Managed exclusively by Cloud Functions Admin SDK
    }

    // ==========================================
    // 12. RESOURCE RELEASE JOBS (Outbox Worker Backend Only)
    // ==========================================
    match /resource_release_jobs/{jobId} {
      allow read, write: if false; // 🔒 Universal Backend-Only: Managed exclusively by Cloud Functions Admin SDK
    }

    // ==========================================
    // 13. CAMPUS STUDENTS (Role-Protected Profiles)
    // ==========================================
    match /students/{studentId} {
      // 🔒 Student records carry allergy and health data. Staff supervisors are
      // deliberately NOT granted a direct read: their access route is the
      // `emergencyMedicalLookup` Cloud Function, which writes an immutable audit
      // entry before returning the profile. Granting a direct read here would let
      // staff read a child's medical history leaving no trace.
      allow read: if isAuthenticated() && (
        isOwner(studentId) ||
        (resource.data.guardianIds != null && request.auth.uid in resource.data.guardianIds) ||
        isAdmin()
      );
      allow create, update, delete: if isStaffSupervisor() || isAdmin();
    }

    // ==========================================
    // 14. PARENT-CHILD LINKS (Guardian Linking)
    // ==========================================
    match /parent_child_links/{linkId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.guardianId) ||
        isOwner(resource.data.studentId) ||
        isStaffSupervisor() ||
        isAdmin()
      );
      allow create: if isAuthenticated() && 
        request.resource.data.guardianId == request.auth.uid &&
        request.resource.data.status == 'PENDING';

      // 🔒 Backend-only: verifying a link is not just a status change. It also writes
      // guardianIds onto the student and wallet documents, which is what grants a
      // guardian access, and it records an audit entry. A staff supervisor editing
      // this document directly would set the status without either, producing a link
      // that reads as VERIFIED while granting nothing — so reviews go through the
      // reviewParentChildLink Cloud Function.
      allow update: if false;
      // A guardian may withdraw a request that has not been decided yet. They may NOT
      // delete a VERIFIED link: verification wrote guardianIds onto the student and
      // wallet, and deleting the link does not remove those, so it would leave the
      // access standing with no record of why. Withdrawing a granted link is
      // revocation, which is staff-only and goes through the Cloud Function.
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.guardianId == request.auth.uid &&
        resource.data.status == 'PENDING'
      );
    }

    // ==========================================
    // 15. STUDENT WALLETS (Cloud Functions Backend-Only Write)
    // ==========================================
    match /wallets/{studentId} {
      allow read: if isAuthenticated() && (
        isOwner(studentId) ||
        (resource.data.guardianIds != null && request.auth.uid in resource.data.guardianIds) ||
        isAdmin()
      );
      allow write: if false; // 🔒 Universal Backend-Only: Wallets writable strictly by Cloud Functions
    }

    // ==========================================
    // 16. WALLET TRANSACTIONS (Cloud Functions Backend-Only Write)
    // ==========================================
    match /wallet_transactions/{txId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.actorUid ||
        isAdmin()
      );
      allow write: if false; // 🔒 Universal Backend-Only: Immutable transaction ledger
    }

    // ==========================================
    // 17. VENDOR APPROVALS (Student Submissions, Staff Reviews)
    // ==========================================
    match /vendor_approvals/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.studentVendorId ||
        isStaffSupervisor() ||
        isAdmin()
      );
      allow create: if isAuthenticated() && 
        request.resource.data.studentVendorId == request.auth.uid &&
        request.resource.data.status == 'PENDING';
      allow update: if isStaffSupervisor() || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 18. STAFF SUPERVISORS (Role-Restricted Directory)
    // ==========================================
    match /staff_supervisors/{staffId} {
      // 🔒 A directory of who supervises what, including their permission flags, is
      // reconnaissance material and was readable by every signed-in user. No client
      // code reads it — the Cloud Functions that consult it use the Admin SDK and
      // bypass these rules — so it is closed to staff reading their own record and
      // to admins.
      allow read: if isAuthenticated() && (isOwner(staffId) || isAdmin());
      allow write: if isAdmin();
    }

    // ==========================================
    // 18.1 ASSISTANT RATE LIMITS (Backend-Only Quota Counters)
    // ==========================================
    match /assistant_rate_limits/{uid} {
      // 🔒 A quota the client could read or reset would not be a quota.
      allow read, write: if false;
    }

    // ==========================================
    // 18.2 PILOT PROGRAMME LEADS (Backend-Only Write, Admin Read)
    // ==========================================
    match /pilot_leads/{leadId} {
      // Schools submit a name, position, phone and email through the public
      // landing page. The page promises to keep that confidential under the PDPA,
      // which rules out a client-writable collection: what a browser can write it
      // can be tricked into writing, and what a browser can read is not
      // confidential. The submitPilotLead Cloud Function is the only writer.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pilot_lead_rate_limits/{callerKey} {
      // 🔒 The only thing standing between an unauthenticated form and a filled
      // collection. Readable or resettable from a client, it would stop one.
      allow read, write: if false;
    }

    // ==========================================
    // 19. EMERGENCY AUDIT LOGS (Strict Append-Only Immutable Log)
    // ==========================================
    match /emergency_audit_logs/{auditId} {
      allow read: if isStaffSupervisor() || isAdmin();
      allow create: if isStaffSupervisor() || isAdmin();
      allow update, delete: if false; // 🔒 Strict Append-Only: Impossible to alter or erase audit logs
    }

    // ==========================================
    // 20. PILOT PROPOSAL LEADS (Admin Read, Backend Only Writes)
    // ==========================================
    match /pilot_leads/{leadId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pilot_lead_rate_limits/{key} {
      allow read, write: if false;
    }

    // ==========================================
    // 21. PRODUCT & STORE REVIEWS
    // ==========================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       isValidNumber(request.resource.data.rating) &&
                       request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       isValidString(request.resource.data.comment, 1, 1000);
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // ==========================================
    // 22. REAL-TIME CUSTOMER-MERCHANT CHAT
    // ==========================================
    match /chats/{chatId} {
      // A chat id is `<customerUid>_<storeId>` (see Chat.tsx).
      //
      // Matched as a prefix rather than by splitting on '_'. Splitting assumes the
      // uid contains no underscore — true of Firebase Auth's own 28-character ids,
      // but not of a custom-token uid, and a security rule should not rest on a
      // convention it cannot enforce. The size check keeps the range in bounds
      // when the id is shorter than the uid.
      function isChatOwner() {
        return isAuthenticated()
          && chatId.size() > request.auth.uid.size()
          && chatId[0:request.auth.uid.size()] == request.auth.uid
          && chatId[request.auth.uid.size():request.auth.uid.size() + 1] == '_';
      }

      // `allow read, write: if isAuthenticated()` let any signed-in student read
      // every other student's conversations with a shop, and post messages into
      // them. Confirmed against the rules engine: a stranger could read a chat
      // containing a phone number and write a message as its owner.
      allow read, write: if isChatOwner() || isAdmin();

      match /messages/{msgId} {
        allow read: if isChatOwner() || isAdmin();
        // senderUid, when present, must be the caller — nobody writes as someone
        // else. The shop's automatic acknowledgement carries no senderUid, which
        // is why this is conditional rather than required.
        allow create: if (isChatOwner() || isAdmin()) &&
          (!('senderUid' in request.resource.data) ||
           request.resource.data.senderUid == request.auth.uid ||
           request.resource.data.senderUid == 'guest');
        allow update, delete: if isAdmin();
      }
    }

    // NOTE: merchants cannot read these chats yet, and do not need to — the shop
    // reply in Chat.tsx is generated client-side by the customer's own browser.
    // When a real merchant inbox is built, give the chat document a participants
    // field and widen the rule to it; do not widen it back to isAuthenticated().

    // ==========================================
    // 23. QUEUE COUNTERS (Cloud Functions Backend Only)
    // ==========================================
    match /queue_counters/{counterId} {
      allow read, write: if false;
    }

  }
}

