rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 🔐 HELPER FUNCTIONS FOR RBAC & AUTHORIZATION
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == '58140@lomsak.ac.th' ||
        request.auth.token.admin == true
      );
    }

    function isStoreOwner(storeId) {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/shops/$(storeId)) && 
         get(/databases/$(database)/documents/shops/$(storeId)).data.ownerUid == request.auth.uid) ||
        (exists(/databases/$(database)/documents/merchantProfiles/$(storeId)) && 
         get(/databases/$(database)/documents/merchantProfiles/$(storeId)).data.ownerUid == request.auth.uid)
      );
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidNumber(val) {
      return val is int || val is float;
    }

    // 🔒 True Order State Machine Validation Helpers
    function isValidStatusTransition(oldStatus, newStatus) {
      return (oldStatus == newStatus) ||
             (oldStatus == 'TO_SHIP' && (newStatus == 'PREPARING' || newStatus == 'CANCELLED')) ||
             (oldStatus == 'PREPARING' && (newStatus == 'READY' || newStatus == 'CANCELLED')) ||
             (oldStatus == 'READY' && newStatus == 'COMPLETED');
    }

    function isValidQueueStatusTransition(oldQueue, newQueue) {
      return (oldQueue == newQueue) ||
             (oldQueue == 'waiting' && (newQueue == 'cooking' || newQueue == 'cancelled')) ||
             (oldQueue == 'cooking' && (newQueue == 'ready' || newQueue == 'cancelled')) ||
             (oldQueue == 'ready' && newQueue == 'completed');
    }

    // ==========================================
    // 1. FOOD CATEGORIES (Public Read, Admin Write)
    // ==========================================
    match /food_categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 2. PRODUCTS / MENU (Store Isolation Enforced)
    // ==========================================
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (request.resource.data.storeId != null && isStoreOwner(request.resource.data.storeId))
      ) && isValidString(request.resource.data.name, 1, 250) && 
        isValidNumber(request.resource.data.price) && request.resource.data.price > 0 &&
        (!('stock' in request.resource.data) || (isValidNumber(request.resource.data.stock) && request.resource.data.stock >= 0));
      
      // 🔒 Lock storeId: Store Owner cannot reassign products to other stores, and price must be positive
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (
          resource.data.storeId != null && 
          isStoreOwner(resource.data.storeId) &&
          request.resource.data.storeId == resource.data.storeId &&
          (!('price' in request.resource.data) || (isValidNumber(request.resource.data.price) && request.resource.data.price > 0)) &&
          (!('stock' in request.resource.data) || (isValidNumber(request.resource.data.stock) && request.resource.data.stock >= 0))
        )
      );
      
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.storeId != null && isStoreOwner(resource.data.storeId))
      );
    }

    // ==========================================
    // 3. SHOPS (Public Read, Owner / Admin Write)
    // ==========================================
    match /shops/{shopId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);
      
      // 🔒 Lock ownerUid: Store Owner cannot transfer store ownership without Admin
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isStoreOwner(shopId) &&
          request.resource.data.ownerUid == resource.data.ownerUid
        )
      );
      allow delete: if isAdmin();

      // Subcollection for store-isolated orders
      match /orders/{orderId} {
        allow read: if isAuthenticated() && (isStoreOwner(shopId) || isAdmin() || resource.data.userId == request.auth.uid);
        allow create: if isAuthenticated() && (
          isAdmin() ||
          (request.resource.data.userId == request.auth.uid && request.resource.data.storeId == shopId)
        );
        allow update, delete: if isStoreOwner(shopId) || isAdmin();
      }

      // Subcollection for shop staff management
      match /staff/{staffUid} {
        allow read: if isAuthenticated() && (isStoreOwner(shopId) || request.auth.uid == staffUid || isAdmin());
        allow write: if isStoreOwner(shopId) || isAdmin();
      }
    }

    // ==========================================
    // 4. USERS COLLECTION (Ownership & Admin Protected)
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // On creation, normal users can only initialize profile data with non-privileged roles and safe keys
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (
          isOwner(userId) &&
          (!('roles' in request.resource.data) || request.resource.data.roles == ['customer'] || request.resource.data.roles == ['user']) &&
          (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false) &&
          (!('isMerchantVerified' in request.resource.data) || request.resource.data.isMerchantVerified == false) &&
          (!('isMerchantRegistered' in request.resource.data) || request.resource.data.isMerchantRegistered == false) &&
          (!('activeRole' in request.resource.data) || request.resource.data.activeRole == 'customer' || request.resource.data.activeRole == 'user') &&
          (!('storeId' in request.resource.data))
        )
      );

      // 🔒 Lock Privilege Elevation: Users can only edit safe profile keys; roles/storeId/isMerchantVerified are Admin/Backend only
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'displayName', 'phone', 'school', 'photo', 'photoURL', 'avatar', 'email', 'updatedAt'
          ])
        )
      );

      allow delete: if isAdmin(); // Audit Trail protection

      // User Favorites Subcollection
      match /favorites/{favoriteId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }

    // ==========================================
    // 5. MERCHANT PROFILES & FINANCIALS
    // ==========================================
    match /merchantProfiles/{merchantId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isStoreOwner(merchantId);

      // Private Financial & PromptPay Config Subcollection
      match /private/finance {
        allow read, write: if isStoreOwner(merchantId);
      }

      // Staff Management Subcollection
      match /staff/{staffUid} {
        allow read: if isAuthenticated() && (isStoreOwner(merchantId) || request.auth.uid == staffUid);
        allow write: if isStoreOwner(merchantId) && (request.resource == null || request.resource.data.staffUid == staffUid);
      }
    }

    // ==========================================
    // 6. ORDERS (Canonical Order Storage & True State Machine Guard)
    // ==========================================
    match /orders/{orderId} {
      // Customer sees own orders, Merchant sees own store orders, Admin sees all
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        (resource.data.storeId != null && isStoreOwner(resource.data.storeId))
      );

      // 🔒 Order Creation Integrity:
      // Online payment orders are created authoritatively by Cloud Functions.
      // Offline orders (cash/counter) created by clients must have strict pending state.
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.paymentMethod in ['cash', 'canteen_counter', 'promptpay_slip'] &&
          (
            !('paymentStatus' in request.resource.data) ||
            request.resource.data.paymentStatus == 'pending' ||
            request.resource.data.paymentStatus == 'unpaid'
          ) &&
          isValidNumber(request.resource.data.totalAmount) &&
          request.resource.data.totalAmount > 0
        )
      );

      // 🔒 Restricted Update Keys & True State Transitions:
      // Merchant can ONLY advance status forward (TO_SHIP -> PREPARING -> READY -> COMPLETED)
      // Merchant CANNOT mutate paymentStatus directly (must use resolvePaidAfterExpiredOrder Cloud Function)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.storeId != null && 
          isStoreOwner(resource.data.storeId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['queueStatus', 'status', 'estimatedReadyTime', 'merchantNote', 'updatedAt']) &&
          (!('status' in request.resource.data) || isValidStatusTransition(resource.data.status, request.resource.data.status)) &&
          (!('queueStatus' in request.resource.data) || isValidQueueStatusTransition(resource.data.queueStatus, request.resource.data.queueStatus))
        ) ||
        (
          // 🔒 Customer can only cancel prior to kitchen preparation (TO_SHIP & waiting)
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'TO_SHIP' &&
          (resource.data.queueStatus == 'waiting' || !('queueStatus' in resource.data)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelReason', 'status', 'queueStatus', 'updatedAt']) &&
          request.resource.data.status == 'CANCELLED' &&
          (!('queueStatus' in request.resource.data) || request.resource.data.queueStatus == 'cancelled')
        )
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // 7. SECURITY & AUDIT LOGS (Immutable Append-Only)
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // 🔒 Prevent spoofing actorUid: Must match authenticated user UID
      allow create: if isAuthenticated() && (request.resource.data.actorUid == request.auth.uid || isAdmin());
      allow update, delete: if false; // Immutable audit log
    }

    // ==========================================
    // 8. SYSTEM EVALUATIONS / SURVEYS
    // ==========================================
    match /systemEvaluations/{evalId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        isValidNumber(request.resource.data.rating) && 
        request.resource.data.rating >= 1 && 
        request.resource.data.rating <= 5;
      allow update, delete: if false; // Immutable evaluation records
    }

    // ==========================================
    // 9. COUPONS & PROMOTIONS (Admin Write, Authenticated Read)
    // ==========================================
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // 10. IDEMPOTENCY KEYS (Internal & Owner Read)
    // ==========================================
    match /idempotency_keys/{keyId} {
      allow read: if isAuthenticated() && (keyId.matches('^' + request.auth.uid + '_.*') || isAdmin());
      allow write: if false; // Only manageable by Cloud Functions / Admin SDK
    }

  }
}
